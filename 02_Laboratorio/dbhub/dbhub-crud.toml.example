# DBHub - Profilo CRUD
# Configurazione di esempio senza credenziali reali

[[sources]]
id = "pagila_crud"
description = "Pagila security laboratory - CRUD profile"
type = "postgres"

host = "127.0.0.1"
port = 5434
database = "pagila"

user = "mcp_crud_pagila"
password = "INSERISCI_PASSWORD_CRUD"

sslmode = "disable"
search_path = "security_lab"

connection_timeout = 15
query_timeout = 30

[[tools]]
name = "execute_sql"
source = "pagila_crud"
readonly = false
max_rows = 1000

[[tools]]
name = "search_objects"
source = "pagila_crud"